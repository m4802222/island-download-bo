BOT_TOKEN=replace_with_a_new_bot_token
OWNER_ID=replace_with_your_telegram_numeric_id
QBIT_URL=http://qbittorrent:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=replace_with_qbittorrent_password
MIN_FREE_GIB=10
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:1.7b
QAS_URL=http://quark-auto-save:5005
QAS_USERNAME=replace_with_qas_webui_username
QAS_PASSWORD=replace_with_qas_webui_password
QUARK_SAVE_PATH=/IslandDownloadBot
ARIA2_URL=http://aria2:6800/jsonrpc
ARIA2_SECRET=replace_with_aria2_rpc_secret
MOVIEPILOT_URL=http://moviepilot:3001
MOVIEPILOT_TOKEN=replace_with_moviepilot_api_token
EMBY_URL=http://emby:8096
EMBY_API_KEY=replace_with_emby_api_key
EMBY_PUBLIC_URL=https://emby.example.com
EMBY_DEFAULT_PASSWORD=123456
MAX_ACTIVE_DOWNLOADS=2
DATA_DIR=/data
DOWNLOADS_DIR=/downloads
QBIT_SAVE_PATH=/downloads/complete/islandbot
# Completed tasks are promoted here only after episode names are normalized.
QBIT_STAGING_PATH=/downloads/incoming/islandbot
MOVIEPILOT_DB=/moviepilot-config/user.db
MOVIEPILOT_CATEGORY_FILE=/moviepilot-config/category.yaml
RCLONE_CONFIG=/rclone/rclone.conf
DRIVE_REMOTE=MP:Media
AUTO_CLEANUP_COMPLETED=true
CLEANUP_INTERVAL_SECONDS=60
# Optional secondary qBittorrent used by the brush-traffic setup.
# Leave empty to disable InfoHash conflict checks.
QBIT2_URL=
QBIT2_USERNAME=
QBIT2_PASSWORD=
